.DS_Store
**/.DS_Store
.claude/
.claude-flow/

# Obsidian vault config — share only what's safe/useful across machines.
# Ignore everything in .obsidian by default, then whitelist specific files.
.obsidian/*
!.obsidian/graph.json
!.obsidian/core-plugins.json
!.obsidian/community-plugins.json

# Never share: personal window/tab layout (churns on every note opened)
# and any plugin data.json (holds API keys/secrets, e.g. Local REST API).
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/plugins/
